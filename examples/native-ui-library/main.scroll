.OrbitHero = (ExperienceBlock)
    : render(self) = [
        element section section root;
        class section "hg-wrap hg-section";
        element eyebrow p section;
        class eyebrow "hg-kicker";
        text eyebrow "{eyebrow}";
        element title h2 section;
        class title "hg-title";
        text title "{title}";
        element frame div section;
        class frame "hg-orbit-frame";
        element ring div frame;
        class ring "hg-orbit-ring";
        element dot1 span ring;
        class dot1 "hg-orbit-dot";
        element dot2 span ring;
        class dot2 "hg-orbit-dot";
