.PosterHero = (EditorialHero)
    : render(self) = [
        element hero section root;
        class hero "hg-cinematic hg-experience";
        element inner div hero;
        class inner "hg-cinematic-inner";
        motion inner blur-in;
        element kicker p inner;
        class kicker "hg-kicker";
        text kicker "{eyebrow}";
        element heading h1 inner;
        class heading "hg-editorial";
        text heading "{title}";
        element body p inner;
        class body "hg-lead";
        text body "{description}";
        element link a inner;
        class link "hg-button hg-button-primary";
        attr link href "{href}";
