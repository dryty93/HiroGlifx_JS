.NewsletterCTA = (ExperienceBlock)
    $ email = "";
    $ confirmation = "Join our newsletter.";
    : render(self) = [
        element section section root;
        class section "hg-wrap hg-section";
        element panel form section;
        class panel "hg-cta-band";
        element eyebrow p panel;
        class eyebrow "hg-kicker";
        text eyebrow "{eyebrow}";
        element heading h2 panel;
        class heading "hg-title";
        text heading "{title}";
        element description p panel;
        class description "hg-lead";
        text description "{description}";
        element input input panel;
        class input "hg-input";
        attr input type "email";
        attr input name "email";
        attr input required "true";
        attr input aria-label "Email address";
        bind input email;
        element submit button panel;
        class submit "hg-button hg-button-primary";
        attr submit type "submit";
        text submit "Join now";
        element notice p panel;
        attr notice role "status";
        attr notice aria-live "polite";
        text notice "{confirmation}";
        on panel submit subscribe;
    ]
    : subscribe(self) = [
        set confirmation "Thank you for your interest.";
    ]
    break;

