.VideoHero = (ExperienceBlock)
    : render(self) = [
        element section section root;
        class section "hg-wrap hg-section";
        element heading h2 section;
        class heading "hg-title";
        text heading "{title}";
        element desc p section;
        class desc "hg-lead";
        text desc "{description}";
        element frame div section;
        class frame "hg-video-frame";
        element video video frame;
        attr video controls "true";
        attr video playsinline "true";
        attr video poster "{src}";
        attr video aria-label "Video showcase. Provide a media source in your application.";
    ]
    break;

.CollagePortfolio = (ExperienceBlock)
    : render(self) = [
        element section section root;
        class section "hg-wrap hg-section";
        element kicker p section;
        class kicker "hg-kicker";
        text kicker "{eyebrow}";
        element heading h2 section;
        class heading "hg-title";
        text heading "{title}";
        element grid div section;
        class grid "hg-gallery";
