.TabbedShowcase = (ExperienceBlock)
    ? showFirst = true;
    : render(self) = [
        element section section root;
        class section "hg-wrap hg-section";
        element heading h2 section;
        class heading "hg-title";
        text heading "{title}";
        element tabs div section;
        class tabs "hg-actions";
        attr tabs role "group";
        attr tabs aria-label "Showcase views";
        element toggle button tabs;
        class toggle "hg-button hg-button-primary";
        attr toggle type "button";
        text toggle "Switch showcase view";
        on toggle click switchView;
        element panelOne article section;
        class panelOne "hg-card";
        show panelOne showFirst;
        element firstHeading h3 panelOne;
        text firstHeading "Design system";
        element firstCopy p panelOne;
        text firstCopy "{description}";
        element panelTwo article section;
        class panelTwo "hg-card";
        hide panelTwo showFirst;
        element secondHeading h3 panelTwo;
        text secondHeading "Interaction system";
        element secondCopy p panelTwo;
        text secondCopy "Different content, same native component.";
    ]
    : switchView(self) = [
        toggle showFirst;
    ]
    break;

