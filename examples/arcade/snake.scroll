// Snake: complete game rules and drawing in HiroGlifx.
// Direction: 0=up, 1=right, 2=down, 3=left.
.Main = ()
    & snake = array(189, 188, 187);
    # direction = 1;
    # nextDirection = 1;
    # food = 194;
    # accumulator = 0;
    # score = 0;
    ? done = false;
    $ message = "";

    : occupied(cell, limit) = [
        for i from 0 to limit [
            if get(snake, i) == cell [
                return true;
            ]
        ]
        return false;
    ]

    : keyEvent(code, pressed) = [
        if pressed [
            if (code == "ArrowUp" || code == "KeyW") && direction != 2 [
                nextDirection = 0;
            ]
            if (code == "ArrowRight" || code == "KeyD") && direction != 3 [
                nextDirection = 1;
            ]
            if (code == "ArrowDown" || code == "KeyS") && direction != 0 [
                nextDirection = 2;
            ]
            if (code == "ArrowLeft" || code == "KeyA") && direction != 1 [
                nextDirection = 3;
            ]
        ]
    ]

    : tick(dt) = [
        accumulator = accumulator + dt;
        while accumulator >= 0.125 && !done [
            accumulator = accumulator - 0.125;
            direction = nextDirection;
            let head = get(snake, 0);
            let x = head % 20;
            let y = floor(head / 20);
            if direction == 0 [
                y = y - 1;
            ]
            if direction == 1 [
                x = x + 1;
            ]
            if direction == 2 [
                y = y + 1;
            ]
            if direction == 3 [
                x = x - 1;
            ]
            if x < 0 || x >= 20 || y < 0 || y >= 13 [
                done = true;
                message = "Game over! Apples: " + score;
                return 0;
            ]
            let next = y * 20 + x;
            let eating = next == food;
            let limit = len(snake) - 1;
            if eating [
                limit = len(snake);
            ]
            if occupied(next, limit) [
                done = true;
                message = "You bit your tail! Apples: " + score;
                return 0;
            ]
            unshift(snake, next);
            if eating [
                score = score + 1;
                if len(snake) >= 260 [
                    done = true;
                    message = "Perfect snake!";
                    return 0;
                ]
                food = floor(random() * 260);
                while occupied(food, len(snake)) [
                    food = (food + 1) % 260;
                ]
            ]
            if !eating [
                pop(snake);
            ]
        ]
    ]

    : draw() = [
        clear("#0b1730");
        for y from 0 to 13 [
            for x from 0 to 20 [
                if (x + y) % 2 == 0 [
                    rect(x * 35 + 50, y * 35 + 30, 33, 33, "#142f4a");
                ]
                if (x + y) % 2 != 0 [
                    rect(x * 35 + 50, y * 35 + 30, 33, 33, "#102942");
                ]
            ]
        ]
        rect((food % 20) * 35 + 54, floor(food / 20) * 35 + 34, 25, 25, "#fa7d8f");
        for i from 0 to len(snake) [
            let cell = get(snake, i);
            let x = cell % 20;
            let y = floor(cell / 20);
            if i == 0 [
                rect(x * 35 + 52, y * 35 + 32, 29, 29, "#bdfce0");
            ]
            if i != 0 [
                rect(x * 35 + 52, y * 35 + 32, 29, 29, "#5eceb0");
            ]
        ]
        text("APPLES " + score, 400, 506, 20, "#e6f7ff");
        if done [
            rect(170, 204, 460, 120, "#122747");
            text(message, 400, 264, 24, "#ffdd92");
        ]
    ]
    break;
