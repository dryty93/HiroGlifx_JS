// Extendable canonical HiroGlifx classes.
.Actor = ()
    # speed = 6;
    $ label = "Starter";
    : leap = self.jump();
    break;

.Runner = (Actor)
    # speed = 8;
    $ label = "Obby Runner";
    : dash = self.move(1, 0);
    break;

.Main = ()
    & world = obby_world();
    & start = obby_tile(world, "start", 0, 0, 0, 4, "solid");
    & step1 = obby_tile(world, "step1", 4.5, 0, 0, 3, "solid");
    & step2 = obby_tile(world, "step2", 9, 0, 1.3, 3, "solid");
    & lava = obby_tile(world, "lava", 13.5, 0, 1.3, 3, "lava");
    & step3 = obby_tile(world, "step3", 18, 0, 0, 3, "solid");
    & checkpoint = obby_tile(world, "checkpoint", 22.5, 0, 0, 3, "checkpoint");
    & step4 = obby_tile(world, "step4", 27, 0, -1.3, 3, "solid");
    & step5 = obby_tile(world, "step5", 31.5, 0, -1.3, 3, "solid");
    & finish = obby_tile(world, "finish", 36, 0, 0, 3, "finish");
    & player = obby_player(world, "hero", 0, 2, 0);
    & runner = bp_create("Runner", player);
    @ won = obby_event(world, "finish");
    @ checkpointHit = obby_event(world, "checkpoint");
    break;
