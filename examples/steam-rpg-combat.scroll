// Phase 23–26: actual encounter rules. Generic physics and rendering stay in engine.
// Every numeric balance decision below is executable HiroGlifx.
.Main = ()
    # damage = 24;
    # staminaCost = 18;
    # cooldown = 0.48;
    # range = 2.8;
    # enemyDamage = 9;
    # enemyRange = 2.1;
    # enemyAggro = 24;
    # enemyCooldown = 1.3;
    # enemyWindup = 0.42;
    # evadeDuration = 0.35;
    # evadeCost = 22;
    # evadeCooldown = 0.9;
    # parryDuration = 0.25;
    # parryCost = 15;
    # parryCooldown = 1.15;
    # kills = 0;
    # attacks = 0;
    # elapsed = 0;
    ? done = false;
    $ message = "Defeat the raiders and their captain.";

    : tick(dt) = [
        elapsed = elapsed + dt;
    ]

    : heroDamage(combo) = [
        return damage + min(combo, 3) * 7;
    ]

    : canEnemyChase(distance) = [
        return distance <= enemyAggro;
    ]

    : canEnemyStrike(distance) = [
        return distance <= enemyRange;
    ]

    : afterEnemyDefeated() = [
        kills = kills + 1;
        if kills >= 7 [
            done = true;
            message = "The Rift Guardian has fallen!";
        ]
        return kills;
    ]

    : draw() = [
        // Babylon.js is the 3D renderer.
    ]
    break;
