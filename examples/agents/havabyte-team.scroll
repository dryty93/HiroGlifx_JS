// Demonstration of native HiroGlifx class inheritance for a reusable agent team.
// These definitions are executable language objects when loaded by a compatible
// class-capable HiroGlifx runtime; they do not make external AI calls.
import agentkit

.HavabyteResearch = (ResearchAgent)
    $ mission = "Discover small, overlooked software opportunities for Havabyte.";
    $ output = "problem, real_customer_quotes, links, existing_tools, MVP, monetization, confidence";
    break;

.HavabyteGrowth = (GrowthAgent)
    $ mission = "Plan and evaluate acquisition experiments for AudioLingo, Ditto, and UsGrade.";
    break;

.Main = ()
    & research = spawn("HavabyteResearch");
    & growth = spawn("HavabyteGrowth");
    & coordinator = spawn("CoordinatorAgent");
    & qa = spawn("QualityAgent");

    : init() = [
        // The prompts are generated by real inherited method dispatch.
        let researchPrompt = send(research, "describe");
        let growthPrompt = send(growth, "describe");
        let leadPrompt = send(coordinator, "describe");
        let qaPrompt = send(qa, "describe");
        // Host integration later sends these prompts to approved model adapters.
    ]
    break;
