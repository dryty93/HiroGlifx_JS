// Definitions-only importable HiroGlifx agent team.
// Agent runner reads this source plus an approved, pinned "agentkit" package.
import agentkit

// Preparation can succeed while private Drive delivery still needs its bridge.
.JobPreparation = (Agent)
    $ role = "Private job preparation and queue operator";
    $ mission = "Prepare factual application packets and verify the owner review queue.";
    $ workflow = "discover -> qualify -> deduplicate -> prepare actual packets -> verify review queue";
    $ tools = "prepare_job_queue";
    $ rules = "Preserve supported facts. Meeting load is advisory only. Report pending file delivery separately. Never claim employer submission from preparation.";
    $ output = "prepared_count, queue_delivered, artifact_delivered, delivery_verified, submitted";
    $ requiredTool = "prepare_job_queue";
    $ schedule = "daily";
    # maxSteps = 2;
    # maxToolCalls = 1;
    ? requireToolEvidence = true;
    break;

.HavabyteResearch = (ResearchAgent)
    $ mission = "Discover small, overlooked software opportunities for Havabyte.";
    $ output = "problem, real_customer_quotes, links, existing_tools, MVP, monetization, confidence";
    break;

.HavabyteGrowth = (GrowthAgent)
    $ mission = "Plan and evaluate acquisition experiments for AudioLingo, Ditto, and UsGrade.";
    break;

// A required capability is evidence, not an automatic grant of permission.
.CrealytesReview = (GrowthAgent)
    $ role = "Crea-Lytes content preparation operator";
    $ mission = "Deliver one finished creative and caption for manual review.";
    $ workflow = "load approved product references -> prepare creative and caption -> deliver private review package -> verify receipt";
    $ tools = "prepare_crealytes_review";
    $ rules = "Use approved packaging and label facts. Preserve feedback. Never publish or claim sales without host-verified receipts.";
    $ output = "package_id, review_url, asset_url, approval_pending, delivery_receipt";
    $ requiredTool = "prepare_crealytes_review";
    $ schedule = "daily";
    # maxSteps = 5;
    # maxToolCalls = 3;
    ? requireToolEvidence = true;
    break;

.JobApplications = (Agent)
    $ role = "Private job application preparation operator";
    $ mission = "Deliver verified job matches, tailored resumes and confirmed application answers.";
    $ workflow = "discover -> verify location and eligibility -> deduplicate -> tailor verified experience -> deliver private review queue -> verify receipt";
    $ tools = "prepare_job_applications";
    $ rules = "Preserve actual employers, titles, dates and experience. Use the target role as a headline. Keep applicant data private. Submitted requires an employer receipt.";
    $ output = "prepared_count, queue_delivered, delivery_verified, submitted, blockers";
    $ requiredTool = "prepare_job_applications";
    $ schedule = "daily";
    # maxSteps = 5;
    # maxToolCalls = 3;
    ? requireToolEvidence = true;
    break;
