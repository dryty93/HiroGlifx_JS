ui application
import native-ui

.Main = ()
    : render(self) = [
        element app main root;
        component ScrollProgress progress app;
        component StickyNavigation nav app;
        prop nav brand "HIRO / CATALOG";
        element intro section app;
        class intro "hg-wrap hg-hero";
        element kicker p intro;
        class kicker "hg-kicker";
        text kicker "NATIVE HIROGLIFX EXPERIENCE CATALOG";
        element heading h1 intro;
        class heading "hg-display";
        text heading "An entire design vocabulary. One import.";
        element summary p intro;
        class summary "hg-lead";
        text summary "Heroes, portfolios, storytelling, comparisons, galleries, product presentations and conversion interfaces. Native .scroll classes with real interactions.";
        element fullGallery section app;
        class fullGallery "hg-wrap hg-section";
        element galleryPanel article fullGallery;
        class galleryPanel "hg-cta-band";
        element galleryEyebrow p galleryPanel;
        class galleryEyebrow "hg-kicker";
        text galleryEyebrow "THE COMPLETE LIVE COMPONENT LIBRARY";
        element galleryTitle h2 galleryPanel;
        class galleryTitle "hg-title";
        text galleryTitle "All 66 components. Every preview on one page.";
        element galleryCopy p galleryPanel;
        class galleryCopy "hg-lead";
        text galleryCopy "Explore the actual native HiroGlifx components, test interactions, and copy a .scroll usage example for every class.";
        element galleryLink a galleryPanel;
        class galleryLink "hg-button hg-button-primary";
        attr galleryLink href "/showcase";
        text galleryLink "Open All Experiences";
        element raindrop section app;
        class raindrop "hg-wrap hg-section";
        element raindropPanel article raindrop;
        class raindropPanel "hg-cta-band";
        element raindropEyebrow p raindropPanel;
        class raindropEyebrow "hg-kicker";
        text raindropEyebrow "FROM THE CURATED RAINDROP COLLECTION";
        element raindropTitle h2 raindropPanel;
        class raindropTitle "hg-title";
        text raindropTitle "Native components with real interactions.";
        element raindropDesc p raindropPanel;
        class raindropDesc "hg-lead";
        text raindropDesc "Explore 18 original HiroGlifx patterns for navigation, reward card reveals, animated mascots, dashboard interfaces and interaction states.";
        element raindropLink a raindropPanel;
        class raindropLink "hg-button hg-button-primary";
        attr raindropLink href "/raindrop-inspiration";
        text raindropLink "Open the new component gallery";
        element categories section app;
        class categories "hg-wrap hg-section";
        element cards div categories;
        class cards "hg-grid";
        element card0 article cards;
        class card0 "hg-card";
        element title0 h2 card0;
        class title0 "hg-bento-title";
        text title0 "Hero experiences";
        element desc0 p card0;
        class desc0 "hg-muted";
        text desc0 "Cinematic, glass, split, product, orbit, motion and video";
        element link0 a card0;
        class link0 "hg-button hg-button-primary";
        attr link0 href "/catalog-heroes";
        text link0 "Explore components";
        element card1 article cards;
        class card1 "hg-card";
        element title1 h2 card1;
        class title1 "hg-bento-title";
        text title1 "Portfolio experiences";
        element desc1 p card1;
        class desc1 "hg-muted";
        text desc1 "Collages, editorial features, product frames, horizontal galleries";
        element link1 a card1;
        class link1 "hg-button hg-button-primary";
        attr link1 href "/catalog-portfolios";
        text link1 "Explore components";
        element card2 article cards;
        class card2 "hg-card";
        element title2 h2 card2;
        class title2 "hg-bento-title";
        text title2 "Narrative experiences";
        element desc2 p card2;
        class desc2 "hg-muted";
        text desc2 "Pinned scroll stories, timelines, process, statistics and comparisons";
        element link2 a card2;
        class link2 "hg-button hg-button-primary";
        attr link2 href "/catalog-stories";
        text link2 "Explore components";
        element card3 article cards;
        class card3 "hg-card";
        element title3 h2 card3;
        class title3 "hg-bento-title";
        text title3 "Conversion experiences";
        element desc3 p card3;
        class desc3 "hg-muted";
        text desc3 "Pricing, social proof, forms, testimonials, tables and CTAs";
        element link3 a card3;
        class link3 "hg-button hg-button-primary";
        attr link3 href "/catalog-conversion";
        text link3 "Explore components";
        component KineticCTA cta app;
        prop cta title "No more assembling every page from scratch.";
        prop cta action "Start with the hero catalog";
        prop cta href "/catalog-heroes";
    ]
    break;
