ui application
import native-ui

// Every component class from native-ui is instantiated below.
// Content, composition, and interactive behavior are native .scroll, not JS.
.Main = ()
    : render(self) = [
        element page main root;
        class page "hg-showcase-page";
        component ScrollProgress progress page;
        element top header page;
        class top "hg-showcase-top";
        element landingHero div top;
        class landingHero "hg-wrap hg-showcase-hero";
        element eyebrow p landingHero;
        class eyebrow "hg-kicker";
        text eyebrow "HIROGLIFX / THE ENTIRE NATIVE COMPONENT LIBRARY";
        element heading h1 landingHero;
        class heading "hg-showcase-display";
        text heading "Every component. One living gallery.";
        element lead p landingHero;
        class lead "hg-lead";
        text lead "66 native HiroGlifx classes, including foundations, sophisticated hero layouts, motion-rich portfolio sections, interactive comparisons and full conversion experiences. Every preview below is rendered from imported .scroll.";
        element stats div landingHero;
        class stats "hg-showcase-stats";
        element count strong stats;
        text count "66";
        element countCaption span stats;
        text countCaption "verified class names across seven collections";
        element actions div landingHero;
        class actions "hg-actions";
        element source a actions;
        class source "hg-button hg-button-primary";
        attr source href "/catalog";
        text source "Explore focused collections";
        element documentation a actions;
        class documentation "hg-button";
        attr documentation href "/showcase";
        text documentation "All components on this page";
        element nav nav page;
        class nav "hg-showcase-nav";
        attr nav aria-label "Jump to component category";
        element navInner div nav;
        class navInner "hg-wrap hg-showcase-nav-items";
        element navfoundation a navInner;
        attr navfoundation href "#hg-showcase-foundation";
        text navfoundation "Foundation & composition";
        element navnavigation a navInner;
        attr navnavigation href "#hg-showcase-navigation";
        text navnavigation "Navigation & site utilities";
        element navhero a navInner;
        attr navhero href "#hg-showcase-hero";
        text navhero "Immersive hero experiences";
        element navvisual a navInner;
        attr navvisual href "#hg-showcase-visual";
        text navvisual "Visual showcase & portfolios";
        element navstory a navInner;
        attr navstory href "#hg-showcase-story";
        text navstory "Scroll storytelling & data";
        element navconversion a navInner;
        attr navconversion href "#hg-showcase-conversion";
        text navconversion "Conversion & interaction";
        element navutility a navInner;
        attr navutility href "#hg-showcase-utility";
        text navutility "Special-purpose experiences";
        element foundation section page;
        attr foundation id "hg-showcase-foundation";
        class foundation "hg-wrap hg-showcase-group";
