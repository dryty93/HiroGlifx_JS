        class foundationTitle "hg-title";
        text foundationTitle "Foundation & composition";
        element foundationDesc p foundationIntro;
        class foundationDesc "hg-lead";
        text foundationDesc "The smallest reusable building blocks. Abstract base classes are shown as component instances, even when they intentionally render no visible DOM.";
        element foundationList div foundation;
        class foundationList "hg-showcase-list";
        element demo0 article foundationList;
        class demo0 "hg-showcase-demo";
        element demo0Header header demo0;
        class demo0Header "hg-showcase-demo-header";
        element demo0Number span demo0Header;
