ui application
import native-ui

// Original HiroGlifx experience patterns from the public Raindrop Design Inspiration collection.
// No React component, copied proprietary code or third-party design asset is embedded.
.Main = ()
    : render(self) = [
        element page main root;
        class page "hg-rain-page";
        component ScrollProgress progress page;
        element intro header page;
        class intro "hg-wrap hg-rain-intro";
        element eyebrow p intro;
        class eyebrow "hg-kicker";
        text eyebrow "HIROGLIFX / RAINDROP DESIGN REFERENCES";
        element heading h1 intro;
        text heading "Every beautiful interaction deserves a simple command.";
        element description p intro;
        class description "hg-lead";
        text description "An original gallery of native HiroGlifx components inspired by a collection of 40 bookmarked UI resources. Click, hover, open, rate, and reveal the components below.";
        element nav nav page;
        class nav "hg-wrap hg-rain-jump";
        attr nav aria-label "Experience categories";
        element jump0 a nav;
        attr jump0 href "#rain-navigation";
        text jump0 "Navigation patterns";
        element jump1 a nav;
        attr jump1 href "#rain-motion";
        text jump1 "Motion and gamification";
        element jump2 a nav;
        attr jump2 href "#rain-product";
        text jump2 "Product interfaces";
        element section0 section page;
        attr section0 id "rain-navigation";
        class section0 "hg-wrap hg-rain-group";
        element title0 h2 section0;
        text title0 "Navigation patterns";
        element subtitle0 p section0;
        class subtitle0 "hg-lead";
        text subtitle0 "Inspired by Navbar Gallery and the navigation patterns saved in the Raindrop collection.";
        element grid0 div section0;
        class grid0 "hg-rain-demo-grid";
        element block0 article grid0;
        class block0 "hg-rain-demo";
        element label0 h3 block0;
        text label0 "AnnouncementRibbon";
        element frame0 div block0;
        component AnnouncementRibbon instance0 frame0;
        element block1 article grid0;
        class block1 "hg-rain-demo wide";
        element label1 h3 block1;
        text label1 "MegaNavigation";
        element frame1 div block1;
        component MegaNavigation instance1 frame1;
        element block2 article grid0;
        class block2 "hg-rain-demo wide";
        element label2 h3 block2;
        text label2 "FullscreenNavigation";
        element frame2 div block2;
        component FullscreenNavigation instance2 frame2;
        element block3 article grid0;
        class block3 "hg-rain-demo";
        element label3 h3 block3;
        text label3 "BreadcrumbTrail";
        element frame3 div block3;
        component BreadcrumbTrail instance3 frame3;
        element block4 article grid0;
        class block4 "hg-rain-demo";
        element label4 h3 block4;
        text label4 "SidebarWorkspace";
        element frame4 div block4;
        component SidebarWorkspace instance4 frame4;
        element block5 article grid0;
        class block5 "hg-rain-demo";
        element label5 h3 block5;
        text label5 "CommandPalette";
        element frame5 div block5;
        component CommandPalette instance5 frame5;
        element section1 section page;
        attr section1 id "rain-motion";
        class section1 "hg-wrap hg-rain-group";
        element title1 h2 section1;
        text title1 "Motion and gamification";
        element subtitle1 p section1;
        class subtitle1 "hg-lead";
        text subtitle1 "Original interactions based on Transitions.dev, Bencho and the two explicit Inspora posts saved in the collection.";
        element grid1 div section1;
        class grid1 "hg-rain-demo-grid";
        element block6 article grid1;
        class block6 "hg-rain-demo";
        element label6 h3 block6;
        text label6 "RewardCardPack";
        element frame6 div block6;
        component RewardCardPack instance6 frame6;
        prop instance6 reward "+250 Hiro Points";
        prop instance6 label "Mystery reward pack";
        element block7 article grid1;
        class block7 "hg-rain-demo wide";
        element label7 h3 block7;
        text label7 "IdleMascot";
        element frame7 div block7;
        component IdleMascot instance7 frame7;
        element block8 article grid1;
        class block8 "hg-rain-demo";
        element label8 h3 block8;
        text label8 "HoverCardStack";
        element frame8 div block8;
        component HoverCardStack instance8 frame8;
        element block9 article grid1;
        class block9 "hg-rain-demo";
        element label9 h3 block9;
        text label9 "SkeletonMorph";
        element frame9 div block9;
        component SkeletonMorph instance9 frame9;
        element block10 article grid1;
        class block10 "hg-rain-demo";
        element label10 h3 block10;
        text label10 "ShimmerHeadline";
        element frame10 div block10;
        component ShimmerHeadline instance10 frame10;
        element block11 article grid1;
        class block11 "hg-rain-demo wide";
        element label11 h3 block11;
        text label11 "GradientMeshBackground";
        element frame11 div block11;
        component GradientMeshBackground instance11 frame11;
        element block12 article grid1;
        class block12 "hg-rain-demo";
        element label12 h3 block12;
        text label12 "SuccessBurst";
        element frame12 div block12;
        component SuccessBurst instance12 frame12;
        element block13 article grid1;
        class block13 "hg-rain-demo";
        element label13 h3 block13;
        text label13 "MotionButtonRow";
        element frame13 div block13;
        component MotionButtonRow instance13 frame13;
        element section2 section page;
        attr section2 id "rain-product";
        class section2 "hg-wrap hg-rain-group";
        element title2 h2 section2;
        text title2 "Product interfaces";
        element subtitle2 p section2;
        class subtitle2 "hg-lead";
        text subtitle2 "UI treatments inspired by BoardUI, Reverse UI and the wider product component galleries.";
        element grid2 div section2;
        class grid2 "hg-rain-demo-grid";
        element block14 article grid2;
        class block14 "hg-rain-demo";
        element label14 h3 block14;
        text label14 "AnimatedPillTabs";
        element frame14 div block14;
        component AnimatedPillTabs instance14 frame14;
        element block15 article grid2;
        class block15 "hg-rain-demo";
        element label15 h3 block15;
        text label15 "ToastNotification";
        element frame15 div block15;
        component ToastNotification instance15 frame15;
        prop instance15 message "Saved in native HiroGlifx.";
        element block16 article grid2;
        class block16 "hg-rain-demo wide";
        element label16 h3 block16;
        text label16 "DashboardAnalytics";
        element frame16 div block16;
        component DashboardAnalytics instance16 frame16;
        element block17 article grid2;
        class block17 "hg-rain-demo";
        element label17 h3 block17;
        text label17 "StarRating";
        element frame17 div block17;
        component StarRating instance17 frame17;
    ]
    break;
