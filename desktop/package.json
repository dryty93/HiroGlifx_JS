{
  "name": "riftfall-hirogame-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Experimental offline desktop build of Riftfall authored in HiroGlifx",
  "main": "main.js",
  "scripts": {
    "stage": "node stage.js",
    "dev": "node stage.js && electron .",
    "package": "node stage.js && electron-builder --dir",
    "dist": "node stage.js && electron-builder",
    "validate": "node --test tests/*.test.js"
  },
  "dependencies": {
    "babylonjs": "9.37.0",
    "babylonjs-loaders": "9.37.0",
    "@babylonjs/havok": "1.3.14"
  },
  "devDependencies": {
    "electron": "45.3.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "dev.hiroglifx.riftfall",
    "productName": "Riftfall - HiroGlifx",
    "artifactName": "Riftfall-HiroGlifx-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "asar": false,
    "files": [
      "main.js",
      "security.js",
      "package.json",
      "dist-web/**/*"
    ],
    "extraMetadata": {
      "main": "main.js"
    },
    "mac": {
      "category": "public.app-category.games",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": false
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "category": "Game",
      "target": [
        "AppImage"
      ]
    },
    "publish": null
  }
}
